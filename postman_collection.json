	"item": [
		{
			"name": "Auth Service",
			"item": [
				{
					"name": "Register Doctor",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "http://localhost:3001/api/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"dr.smith@hospital.com\",\n  \"password\": \"password123\",\n  \"name\": \"Dr. John Smith\",\n  \"role\": \"doctor\"\n}"
						}
					}
				},
				{
					"name": "Register Patient",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "http://localhost:3001/api/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"patient@email.com\",\n  \"password\": \"password123\",\n  \"name\": \"Jane Doe\",\n  \"role\": \"patient\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "http://localhost:3001/api/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"dr.smith@hospital.com\",\n  \"password\": \"password123\"\n}"
						}
					}
				},
				{
					"name": "Verify Token",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
						],
						"url": "http://localhost:3001/api/auth/verify"
					}
				}
			]
		},
